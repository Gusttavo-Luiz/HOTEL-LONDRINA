---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { hotel, phoneHref } from '../config/hotel';
---

<BaseLayout title="Página não encontrada | Hotel Triunfo Londrina" description="A página procurada não foi encontrada." noindex>
  <section class="section">
    <div class="container nf">
      <p class="eyebrow">Erro 404</p>
      <h1>Página não encontrada.</h1>
      <p class="lead">O endereço pode ter mudado. Volte ao início ou ligue para a recepção: {hotel.phone.display}.</p>
      <div class="nf__actions">
        <a href={withBase('/')} class="btn btn--navy">Ir para o início</a>
        <a href={phoneHref} class="btn btn--outline">Ligar para a recepção</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    min-height: 50vh;
    align-content: center;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
