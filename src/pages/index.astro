---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Rooms from '../components/Rooms.astro';
import Amenities from '../components/Amenities.astro';
import Gallery from '../components/Gallery.astro';
import Location from '../components/Location.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import { faq } from '../content/faq';
import { hotel } from '../config/hotel';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${hotel.url}/#website`,
  name: hotel.tradeName,
  url: `${hotel.url}/`,
  inLanguage: 'pt-BR',
};
---

<BaseLayout
  title="Triunfo | Hotel barato em Londrina — hotel no centro de Londrina"
  description="Hotel econômico no centro de Londrina-PR com café da manhã incluso, Wi-Fi e estacionamento gratuitos, aceita pets e recepção 24h. Consulte a disponibilidade."
  jsonLd={[website, faqSchema]}
>
  <Hero />
  <About />
  <Rooms />
  <Amenities />
  <Gallery />
  <Location />
  <Reviews />
  <FAQ />
  <Contact />
</BaseLayout>
