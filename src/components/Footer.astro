---
import { hotel, phoneHref, whatsappUrl } from '../config/hotel';
import { navigation } from '../content/navigation';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
const wa = whatsappUrl();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo tone="light" />
      <p>{hotel.tradeName}. Hospedagem econômica e tradicional no centro de Londrina, com recepção 24 horas.</p>
      <a href={withBase('/#reservar')} class="btn btn--gold btn--sm">Faça sua reserva</a>
    </div>

    <nav aria-label="Rodapé">
      <h2 class="footer__title">Navegação</h2>
      <ul role="list">
        {navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href={withBase('/#duvidas')}>Perguntas frequentes</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="footer__title">Contato</h2>
      <ul role="list" class="footer__contact">
        <li><Icon name="phone" size={18} /><a href={phoneHref}>{hotel.phone.display}</a></li>
        {wa && <li><Icon name="whatsapp" size={18} /><a href={wa} target="_blank" rel="noopener">WhatsApp</a></li>}
        <li><Icon name="clock" size={18} /><span>Recepção 24 horas</span></li>
        <li>
          <Icon name="mapPin" size={18} />
          <address>
            {hotel.address.street}<br />
            {hotel.address.district}, {hotel.address.city} - {hotel.address.state}<br />
            CEP {hotel.address.postalCode}
          </address>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="footer__title">Canais oficiais</h2>
      <ul role="list">
        <li><a href={hotel.links.googleReviews} target="_blank" rel="noopener">Perfil no Google</a></li>
        {hotel.social.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ul>
      <p class="footer__privacy">
        <Icon name="shield" size={16} /> Este site não usa cookies de rastreamento. O mapa do Google só é carregado com a
        sua autorização.
      </p>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p>© {year} {hotel.name} · Londrina - PR. Todos os direitos reservados.</p>
      <a href={withBase('/politica-de-privacidade/')}>Política de Privacidade</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--grad-navy);
    border-top: 3px solid var(--gold-400);
    color: rgb(255 255 255 / 0.74);
    font-size: 0.9375rem;
  }

  .footer__grid {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }

  .footer__brand {
    display: grid;
    gap: 1.1rem;
    align-content: start;
    justify-items: start;
    max-width: 22rem;
  }

  .footer__title {
    margin-bottom: 1rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-300);
  }

  ul {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--white);
    text-decoration: none;
  }

  a:hover {
    color: var(--gold-300);
    text-decoration: underline;
  }

  .footer__brand .btn,
  .footer__brand .btn:hover {
    color: var(--navy-950);
    text-decoration: none;
  }

  .footer__contact li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    line-height: 1.5;
  }

  .footer__contact address {
    font-style: normal;
  }

  .footer :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--gold-300);
  }

  .footer__privacy {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.6);
  }

  .footer__bottom {
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.25rem;
    font-size: 0.875rem;
  }

  @media (min-width: 700px) {
    .footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.3fr 0.9fr 1.1fr 1fr;
    }
  }

  @media (max-width: 767px) {
    .footer {
      padding-bottom: 76px;
    }
  }
</style>
