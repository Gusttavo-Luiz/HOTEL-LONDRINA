---
import type { RoomCategory } from '../data/rooms';
import Photo from './Photo.astro';
import Icon from './Icon.astro';

interface Props {
  room: RoomCategory;
}

const { room } = Astro.props;
const cover = room.photos[0];
const shared = room.bathroom === 'compartilhado';
---

<article class="room" data-reveal aria-labelledby={`room-${room.id}`}>
  <div class="room__media">
    {
      cover ? (
        <Photo file={cover.file} alt={cover.alt} placeholderLabel={room.name} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
      ) : (
        <Photo file={`${room.id}-01.jpg`} alt={room.name} placeholderLabel={room.name} />
      )
    }
    <span class:list={['room__bath', { 'room__bath--shared': shared }]}>
      <Icon name="bath" size={16} /> Banheiro {room.bathroom}
    </span>
  </div>

  <div class="room__body">
    <h3 id={`room-${room.id}`}>{room.name}</h3>
    <p class="room__desc">{room.description}</p>

    <dl class="room__specs">
      <div>
        <dt><Icon name="users" size={18} /> Capacidade</dt>
        <dd>Até {room.maxGuests} {room.maxGuests === 1 ? 'hóspede' : 'hóspedes'}</dd>
      </div>
      <div>
        <dt><Icon name="bed" size={18} /> Camas</dt>
        <dd>{room.beds}</dd>
      </div>
      <div>
        <dt><Icon name="bath" size={18} /> Banheiro</dt>
        <dd>{shared ? 'Compartilhado' : 'Privativo'}</dd>
      </div>
    </dl>

    {
      room.amenities.length > 0 && (
        <ul class="room__amenities" role="list" aria-label="Comodidades">
          {room.amenities.map((item) => (
            <li>
              <Icon name="check" size={16} /> {item}
            </li>
          ))}
        </ul>
      )
    }

    {
      room.notes && room.notes.length > 0 && (
        <ul class="room__notes" role="list" aria-label="Informações importantes">
          {room.notes.map((note) => (
            <li>
              <Icon name="info" size={16} /> {note}
            </li>
          ))}
        </ul>
      )
    }

    <a href="#reservas" class="btn btn--navy btn--block room__cta" data-room-select={room.id}>
      Consultar disponibilidade
    </a>
  </div>
</article>

<style>
  .room {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    overflow: hidden;
    transition:
      box-shadow 0.3s var(--ease),
      transform 0.3s var(--ease);
  }

  .room:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .room__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--sand-200);
  }

  .room__media :global(img),
  .room__media :global(picture),
  .room__media :global(.photo-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .room__bath {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--navy-900);
    color: var(--white);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .room__bath--shared {
    background: var(--gold-400);
    color: var(--navy-950);
  }

  .room__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
  }

  .room h3 {
    font-size: 1.45rem;
  }

  .room__desc {
    color: var(--ink-soft);
  }

  .room__specs {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 1rem 0;
    border-block: 1px solid var(--line);
  }

  .room__specs div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.9375rem;
  }

  .room__specs dt {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-soft);
  }

  .room__specs dt svg {
    color: var(--gold-700);
  }

  .room__specs dd {
    margin: 0;
    font-weight: 650;
    color: var(--navy-900);
    text-align: right;
  }

  .room__amenities,
  .room__notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .room__amenities li,
  .room__notes li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .room__amenities svg {
    color: var(--success);
  }

  .room__notes {
    flex-direction: column;
    color: var(--ink-soft);
  }

  .room__notes svg {
    flex: none;
    color: var(--navy-700);
  }

  .room__cta {
    margin-top: auto;
  }
</style>
