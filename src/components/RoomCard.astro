---
import type { Room } from '../content/rooms';
import { formatBRL } from '../config/hotel';
import Photo from './Photo.astro';
import Icon from './Icon.astro';

interface Props {
  room: Room;
}

const { room } = Astro.props;
const cover = room.photos[0] ?? { file: `${room.id}-01.jpg`, alt: room.name };
---

<article class="room" aria-labelledby={`quarto-${room.id}`} data-reveal>
  <div class="room__media">
    <Photo file={cover.file} alt={cover.alt} label={room.name} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw">
      <div slot="fallback" class="room__fallback" aria-hidden="true"><Icon name="image" size={28} /></div>
    </Photo>
    {room.status === 'provisorio' && <span class="dev-badge room__badge">Dados provisórios</span>}
  </div>
  <div class="room__body">
    <h3 id={`quarto-${room.id}`}>{room.name}</h3>
    <p class="room__desc">{room.description}</p>
    <p class="room__capacity"><Icon name="users" size={18} /> Até {room.capacity} {room.capacity === 1 ? 'hóspede' : 'hóspedes'}</p>
    <ul class="room__amenities" role="list" aria-label="Comodidades">
      {room.amenities.map((a) => <li><Icon name="check" size={15} /> {a}</li>)}
    </ul>
    <div class="room__footer">
      <p class="room__price">
        {
          room.priceFrom ? (
            <>
              <small>A partir de</small> {formatBRL(room.priceFrom)}
              <small>/ diária*</small>
            </>
          ) : (
            <small>Consulte tarifas para suas datas</small>
          )
        }
      </p>
      <a href="#solicitacao" class="btn btn--navy btn--sm" data-room={room.id}>Consultar este quarto</a>
    </div>
  </div>
</article>

<style>
  .room {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .room:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .room__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--sand-200);
  }

  .room__media :global(picture),
  .room__media :global(img),
  .room__media :global(.photo-pending) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .room__fallback {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--sand-300);
  }

  .room__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
  }

  .room__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.4rem;
  }

  h3 {
    font-size: 1.4rem;
  }

  .room__desc {
    color: var(--gray-600);
    font-size: 0.9875rem;
  }

  .room__capacity {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 650;
    color: var(--navy-900);
  }

  .room__capacity :global(svg) {
    color: var(--gold-700);
  }

  .room__amenities {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--gray-600);
  }

  .room__amenities li {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .room__amenities :global(svg) {
    color: var(--success);
  }

  .room__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .room__price {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--navy-900);
  }

  .room__price small {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--gray-600);
  }
</style>
