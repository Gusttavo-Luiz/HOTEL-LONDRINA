---
/**
 * Foto oficial de src/assets/fotos. Sem o arquivo, mostra uma moldura
 * "Foto pendente" somente no ambiente de desenvolvimento; em produção
 * renderiza o slot `fallback` (ou nada).
 */
import { Picture } from 'astro:assets';
import { getPhoto } from '../lib/photos';
import { showProvisional } from '../config/flags';
import Icon from './Icon.astro';

interface Props {
  file: string;
  alt: string;
  label?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  class?: string;
}

const {
  file,
  alt,
  label,
  widths = [480, 800, 1200],
  sizes = '(min-width: 1024px) 33vw, 100vw',
  loading = 'lazy',
  priority = false,
  class: className,
} = Astro.props;

const image = getPhoto(file);
const usable = image ? widths.filter((w) => w <= image.width) : [];
if (image && usable.length === 0) usable.push(image.width);
---

{
  image ? (
    <Picture
      src={image}
      alt={alt}
      widths={usable}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={priority ? 'eager' : loading}
      decoding={priority ? 'sync' : 'async'}
      fetchpriority={priority ? 'high' : undefined}
      class={className}
    />
  ) : showProvisional ? (
    <div class:list={['photo-pending', className]} role="img" aria-label={`Foto pendente: ${label ?? alt}`}>
      <Icon name="image" size={26} />
      <span class="photo-pending__title">Foto pendente</span>
      <span class="photo-pending__label">{label ?? alt}</span>
      <code>{file}</code>
    </div>
  ) : (
    <slot name="fallback" />
  )
}

<style>
  .photo-pending {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    width: 100%;
    height: 100%;
    min-height: 160px;
    padding: 1rem;
    text-align: center;
    color: #7a5200;
    background: repeating-linear-gradient(-45deg, #fff6e0 0 14px, #fdf0cf 14px 28px);
    border: 2px dashed #d9a521;
  }

  .photo-pending__title {
    margin-top: 0.3rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .photo-pending__label {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--navy-900);
  }

  code {
    font-size: 0.75rem;
    color: var(--gray-600);
  }
</style>
