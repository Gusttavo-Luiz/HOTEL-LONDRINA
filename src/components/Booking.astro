---
import { site, phoneHref, whatsappUrl } from '../config/site';
import { rooms } from '../data/rooms';
import Icon from './Icon.astro';

const engine = site.links.bookingEngine;
const waLink = whatsappUrl('Olá! Gostaria de fazer uma reserva no Hotel Triunfo.');
---

<section id="reservas" class="section section--navy booking" aria-labelledby="reservas-title">
  <div class="container booking__grid">
    <div class="booking__intro" data-reveal>
      <p class="eyebrow">Reservas</p>
      <h2 id="reservas-title">Planeje sua estadia em Londrina.</h2>
      <p class="lead">
        Consulte nossas opções de hospedagem, verifique a disponibilidade e entre em contato com nossa equipe para
        realizar sua reserva.
      </p>

      <div class="booking__actions">
        {
          engine ? (
            <a href={engine} class="btn btn--primary" target="_blank" rel="noopener">
              <Icon name="calendar" /> Fazer reserva online
            </a>
          ) : (
            <a href="#form-reserva" class="btn btn--primary" data-focus-form>
              <Icon name="calendar" /> Fazer reserva online
            </a>
          )
        }
        <a href={waLink} class="btn btn--whatsapp" target="_blank" rel="noopener">
          <Icon name="whatsapp" /> Reservar pelo WhatsApp
        </a>
      </div>

      <ul class="booking__contacts" role="list">
        <li>
          <span class="booking__contact-icon"><Icon name="phone" size={20} /></span>
          <span>
            <small>Telefone</small>
            <a href={phoneHref}>{site.contact.phone.display}</a>
          </span>
        </li>
        <li>
          <span class="booking__contact-icon"><Icon name="whatsapp" size={20} /></span>
          <span>
            <small>WhatsApp / celular</small>
            <a href={waLink} target="_blank" rel="noopener">{site.contact.whatsapp.display}</a>
          </span>
        </li>
        <li>
          <span class="booking__contact-icon"><Icon name="clock" size={20} /></span>
          <span>
            <small>Recepção</small>
            <strong>{site.contact.hours}</strong>
          </span>
        </li>
      </ul>
    </div>

    <div class="booking__card" data-reveal>
      <form id="form-reserva" class="booking__form" novalidate data-booking-form aria-describedby="reserva-aviso">
        <div class="booking__card-head">
          <h3>Solicitar reserva</h3>
          <p id="reserva-aviso">
            Preencha os dados e envie sua solicitação para a recepção pelo WhatsApp. A disponibilidade e os valores são
            confirmados pela nossa equipe — <strong>a reserva só é garantida após essa confirmação</strong>.
          </p>
        </div>

        <fieldset class="booking__fieldset">
          <legend class="visually-hidden">Datas da estadia</legend>
          <div class="booking__row">
            <div class="field">
              <label for="reserva-checkin">Check-in <span class="req" aria-hidden="true">*</span></label>
              <input class="input" type="date" id="reserva-checkin" name="checkin" required aria-describedby="erro-checkin" />
              <p class="field-error" id="erro-checkin" data-error-for="checkin" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="reserva-checkout">Check-out <span class="req" aria-hidden="true">*</span></label>
              <input class="input" type="date" id="reserva-checkout" name="checkout" required aria-describedby="erro-checkout" />
              <p class="field-error" id="erro-checkout" data-error-for="checkout" aria-live="polite"></p>
            </div>
          </div>
          <p class="booking__nights" data-nights aria-live="polite"></p>
        </fieldset>

        <div class="booking__row">
          <div class="field">
            <label for="reserva-hospedes">Hóspedes <span class="req" aria-hidden="true">*</span></label>
            <select class="input" id="reserva-hospedes" name="guests" required aria-describedby="erro-guests">
              {Array.from({ length: 10 }, (_, i) => <option value={i + 1} selected={i === 0}>{i + 1} {i === 0 ? 'hóspede' : 'hóspedes'}</option>)}
              <option value="mais de 10">Mais de 10</option>
            </select>
            <p class="field-error" id="erro-guests" data-error-for="guests" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="reserva-quartos">Quartos <span class="req" aria-hidden="true">*</span></label>
            <select class="input" id="reserva-quartos" name="rooms" required aria-describedby="erro-rooms">
              {Array.from({ length: 6 }, (_, i) => <option value={i + 1} selected={i === 0}>{i + 1} {i === 0 ? 'quarto' : 'quartos'}</option>)}
              <option value="mais de 6">Mais de 6</option>
            </select>
            <p class="field-error" id="erro-rooms" data-error-for="rooms" aria-live="polite"></p>
          </div>
        </div>

        {
          rooms.length > 0 && (
            <div class="field">
              <label for="reserva-categoria">Acomodação de preferência</label>
              <select class="input" id="reserva-categoria" name="category">
                <option value="">Sem preferência</option>
                {rooms.map((room) => (
                  <option value={room.id}>
                    {room.name} — banheiro {room.bathroom}
                  </option>
                ))}
              </select>
            </div>
          )
        }

        <div class="booking__row">
          <div class="field">
            <label for="reserva-nome">Nome completo <span class="req" aria-hidden="true">*</span></label>
            <input class="input" type="text" id="reserva-nome" name="name" autocomplete="name" maxlength="120" required aria-describedby="erro-name" />
            <p class="field-error" id="erro-name" data-error-for="name" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="reserva-telefone">Telefone / WhatsApp <span class="req" aria-hidden="true">*</span></label>
            <input
              class="input"
              type="tel"
              id="reserva-telefone"
              name="phone"
              autocomplete="tel"
              inputmode="tel"
              placeholder="(43) 99999-9999"
              maxlength="20"
              required
              aria-describedby="erro-phone"
            />
            <p class="field-error" id="erro-phone" data-error-for="phone" aria-live="polite"></p>
          </div>
        </div>

        <div class="field">
          <label for="reserva-obs">Observações <span class="hint">(opcional)</span></label>
          <textarea
            class="input"
            id="reserva-obs"
            name="notes"
            rows="3"
            maxlength="600"
            placeholder="Ex.: preferência de banheiro, horário previsto de chegada, estadia a trabalho com nota para empresa…"
          ></textarea>
        </div>

        <p class="booking__required"><span class="req" aria-hidden="true">*</span> Campos obrigatórios</p>

        <button type="submit" class="btn btn--primary btn--block">
          <Icon name="whatsapp" /> Enviar solicitação pelo WhatsApp
        </button>

        <div class="form-status" data-form-status role="status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<script>
  import { whatsappUrl } from '../config/site';
  import { rooms } from '../data/rooms';
  import {
    addDays,
    clean,
    formatDateBR,
    formatPhone,
    isValidName,
    nightsBetween,
    normalizePhone,
    parseISODate,
    toISODate,
    today,
    validateStay,
    MAX_DAYS_AHEAD,
  } from '../lib/validation';
  import { applyErrors, clearErrors, escapeHTML, openExternal, setFieldError, setStatus } from '../scripts/form-ui';

  const form = document.querySelector<HTMLFormElement>('[data-booking-form]');

  if (form) {
    const checkin = form.elements.namedItem('checkin') as HTMLInputElement;
    const checkout = form.elements.namedItem('checkout') as HTMLInputElement;
    const phone = form.elements.namedItem('phone') as HTMLInputElement;
    const nights = form.querySelector<HTMLElement>('[data-nights]')!;

    const now = today();
    checkin.min = toISODate(now);
    checkin.max = toISODate(addDays(now, MAX_DAYS_AHEAD));
    checkout.min = toISODate(addDays(now, 1));

    const updateNights = () => {
      const { errors, checkIn, checkOut } = validateStay(checkin.value, checkout.value);
      nights.textContent =
        checkIn && checkOut && !errors.checkin && !errors.checkout
          ? `${nightsBetween(checkIn, checkOut)} ${nightsBetween(checkIn, checkOut) === 1 ? 'noite' : 'noites'} de hospedagem`
          : '';
    };

    checkin.addEventListener('change', () => {
      const date = parseISODate(checkin.value);
      if (date) {
        const minOut = addDays(date, 1);
        checkout.min = toISODate(minOut);
        // Ajusta o check-out automaticamente se ficou antes do novo check-in.
        const out = parseISODate(checkout.value);
        if (!out || out <= date) checkout.value = toISODate(minOut);
      }
      setFieldError(form, 'checkin', validateStay(checkin.value, checkout.value).errors.checkin);
      setFieldError(form, 'checkout', undefined);
      updateNights();
    });

    checkout.addEventListener('change', () => {
      setFieldError(form, 'checkout', validateStay(checkin.value, checkout.value).errors.checkout);
      updateNights();
    });

    phone.addEventListener('blur', () => {
      const digits = normalizePhone(phone.value);
      if (digits) phone.value = formatPhone(digits);
    });

    form.addEventListener('input', (event) => {
      const target = event.target as HTMLInputElement;
      if (target.getAttribute('aria-invalid') === 'true' && target.name !== 'checkin' && target.name !== 'checkout') {
        setFieldError(form, target.name, undefined);
      }
    });

    // Botão "Fazer reserva online" sem motor de reservas: leva ao formulário.
    document.querySelectorAll<HTMLAnchorElement>('[data-focus-form]').forEach((link) =>
      link.addEventListener('click', () => setTimeout(() => checkin.focus({ preventScroll: true }), 400)),
    );

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      clearErrors(form);
      setStatus(form, '', '');

      const data = new FormData(form);
      const name = clean(String(data.get('name') ?? ''), 120);
      const phoneDigits = normalizePhone(String(data.get('phone') ?? ''));
      const guests = clean(String(data.get('guests') ?? ''), 20);
      const roomsQty = clean(String(data.get('rooms') ?? ''), 20);
      const notes = clean(String(data.get('notes') ?? ''), 600);
      const categoryId = String(data.get('category') ?? '');
      const category = rooms.find((room) => room.id === categoryId);

      const { errors, checkIn, checkOut } = validateStay(String(data.get('checkin') ?? ''), String(data.get('checkout') ?? ''));
      const allErrors: Record<string, string | undefined> = {
        ...errors,
        guests: guests ? undefined : 'Informe o número de hóspedes.',
        rooms: roomsQty ? undefined : 'Informe o número de quartos.',
        name: isValidName(name) ? undefined : 'Informe seu nome completo.',
        phone: phoneDigits ? undefined : 'Informe um telefone válido com DDD, por exemplo (43) 99999-9999.',
      };

      if (!applyErrors(form, allErrors) || !checkIn || !checkOut || !phoneDigits) return;

      const n = nightsBetween(checkIn, checkOut);
      const message = [
        'Olá! Gostaria de solicitar uma reserva no Hotel Triunfo.',
        '',
        `• Check-in: ${formatDateBR(checkIn)}`,
        `• Check-out: ${formatDateBR(checkOut)} (${n} ${n === 1 ? 'noite' : 'noites'})`,
        `• Hóspedes: ${guests}`,
        `• Quartos: ${roomsQty}`,
        category ? `• Acomodação: ${category.name} (banheiro ${category.bathroom})` : null,
        `• Nome: ${name}`,
        `• Telefone: ${formatPhone(phoneDigits)}`,
        notes ? `• Observações: ${notes}` : null,
        '',
        'Aguardo a confirmação de disponibilidade e valores.',
      ]
        .filter((line) => line !== null)
        .join('\n');

      const url = whatsappUrl(message);
      const opened = openExternal(url);
      const link = `<a href="${escapeHTML(url)}" target="_blank" rel="noopener">abrir o WhatsApp</a>`;

      setStatus(
        form,
        'success',
        opened
          ? `Sua solicitação foi preparada no WhatsApp. <strong>Envie a mensagem</strong> para que a recepção verifique a disponibilidade. Se a conversa não abriu, clique para ${link}.`
          : `Seu navegador bloqueou a nova janela. Clique para ${link} e enviar sua solicitação à recepção.`,
      );
    });
  }
</script>

<style>
  .booking {
    position: relative;
    /* clip (e não hidden) para não quebrar o position: sticky do bloco de texto */
    overflow: clip;
  }

  .booking::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(214 174 102 / 0.12), transparent 65%);
    pointer-events: none;
  }

  .booking__grid {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .booking__intro {
    display: grid;
    gap: 1.25rem;
  }

  .booking__intro h2 {
    font-size: clamp(2rem, 4.4vw, 3rem);
  }

  .booking__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .booking__contacts {
    display: grid;
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    list-style: none;
  }

  .booking__contacts li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .booking__contacts small {
    display: block;
    font-size: 0.8125rem;
    color: rgb(245 239 229 / 0.7);
  }

  .booking__contacts a,
  .booking__contacts strong {
    font-size: 1.125rem;
    font-weight: 650;
    color: var(--white);
    text-decoration: none;
  }

  .booking__contacts a:hover {
    color: var(--gold-300);
    text-decoration: underline;
  }

  .booking__contact-icon {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgb(214 174 102 / 0.14);
    color: var(--gold-300);
  }

  .booking__card {
    padding: clamp(1.25rem, 3.5vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--ink);
    box-shadow: var(--shadow-lg);
  }

  .booking__form {
    display: grid;
    gap: 1.1rem;
  }

  .booking__card-head {
    display: grid;
    gap: 0.5rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .booking__card-head h3 {
    font-size: 1.5rem;
    color: var(--navy-900) !important;
  }

  .booking__card-head p {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .booking__fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .booking__row {
    display: grid;
    gap: 1.1rem;
  }

  .booking__nights {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--success);
  }

  .booking__nights:empty {
    display: none;
  }

  .booking__required {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  @media (min-width: 560px) {
    .booking__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .booking__grid {
      grid-template-columns: 0.9fr 1.1fr;
    }

    .booking__intro {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>
