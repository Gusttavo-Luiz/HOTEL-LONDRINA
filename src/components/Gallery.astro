---
import { getImage } from 'astro:assets';
import { galleryPhotos } from '../content/gallery';
import { getPhoto } from '../lib/photos';
import { showProvisional } from '../config/flags';
import SectionHeading from './SectionHeading.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import Lightbox from './react/Lightbox';

const available = galleryPhotos.filter((p) => getPhoto(p.file));
const lightboxItems = await Promise.all(
  available.map(async (p) => {
    const image = getPhoto(p.file)!;
    const large = await getImage({ src: image, width: Math.min(1800, image.width), format: 'webp', quality: 82 });
    return { src: large.src, alt: p.alt, label: p.label };
  }),
);
const pending = showProvisional ? galleryPhotos.filter((p) => !getPhoto(p.file)) : [];
const show = available.length > 0 || pending.length > 0;
---

{
  show && (
    <section id="galeria" class="section section--white" aria-labelledby="galeria-title">
      <div class="container">
        <SectionHeading eyebrow="Galeria" title="Conheça nossos ambientes." id="galeria-title">
          Fotos do Hotel Triunfo para você conhecer a hospedagem antes de chegar.
        </SectionHeading>

        <Lightbox client:idle items={lightboxItems}>
          <ul class="gallery" role="list">
            {available.map((p, i) => (
              <li>
                <button type="button" class="gallery__item" data-lightbox-index={i} aria-label={`Ampliar foto: ${p.alt}`}>
                  <Photo file={p.file} alt={p.alt} widths={[400, 640, 960]} sizes="(min-width: 1024px) 33vw, 50vw" />
                  <span class="gallery__tag">
                    {p.label} <Icon name="maximize" size={14} />
                  </span>
                </button>
              </li>
            ))}
            {pending.map((p) => (
              <li>
                <div class="gallery__item gallery__item--pending">
                  <Photo file={p.file} alt={p.alt} label={p.label} />
                </div>
              </li>
            ))}
          </ul>
        </Lightbox>
      </div>
    </section>
  )
}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius);
    background: var(--sand-200);
    cursor: zoom-in;
  }

  .gallery__item--pending {
    cursor: default;
  }

  .gallery__item :global(picture),
  .gallery__item :global(img),
  .gallery__item :global(.photo-pending) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .gallery__item:hover :global(img) {
    transform: scale(1.04);
  }

  .gallery__tag {
    position: absolute;
    left: 0.65rem;
    bottom: 0.65rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgb(11 26 48 / 0.78);
    color: var(--white);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }

    .gallery li:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }

    .gallery li:first-child .gallery__item {
      height: 100%;
      aspect-ratio: auto;
    }
  }

  /* Lightbox */
  :global(.lightbox) {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 4.5rem 1rem 1.5rem;
    border: 0;
    background: rgb(6 15 29 / 0.95);
    color: var(--white);
  }

  :global(.lightbox[open]) {
    display: grid;
    place-items: center;
  }

  :global(.lightbox::backdrop) {
    background: rgb(6 15 29 / 0.6);
  }

  :global(.lightbox__figure) {
    display: grid;
    justify-items: center;
    gap: 0.85rem;
    margin: 0;
  }

  :global(.lightbox__img) {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    border-radius: var(--radius-sm);
    object-fit: contain;
  }

  :global(.lightbox figcaption) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1rem;
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.85);
  }

  :global(.lightbox__count) {
    color: var(--gold-300);
    font-weight: 600;
  }

  :global(.lightbox__btn) {
    position: absolute;
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: var(--white);
    cursor: pointer;
  }

  :global(.lightbox__btn:hover) {
    background: rgb(255 255 255 / 0.2);
  }

  :global(.lightbox__close) {
    top: 1rem;
    right: 1rem;
  }

  :global(.lightbox__prev),
  :global(.lightbox__next) {
    top: 50%;
    transform: translateY(-50%);
  }

  :global(.lightbox__prev) {
    left: 1rem;
  }

  :global(.lightbox__next) {
    right: 1rem;
  }

  @media (max-width: 639px) {
    :global(.lightbox__prev),
    :global(.lightbox__next) {
      top: auto;
      bottom: 1rem;
      transform: none;
    }

    :global(.lightbox) {
      padding-bottom: 5rem;
    }
  }
</style>
