---
import { faq } from '../content/faq';
import { hotel, phoneHref } from '../config/hotel';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section id="duvidas" class="section section--sand" aria-labelledby="duvidas-title">
  <div class="container faq">
    <div>
      <SectionHeading eyebrow="Perguntas frequentes" title="Tire suas dúvidas antes de reservar." id="duvidas-title">
        Não encontrou a resposta? A recepção atende 24 horas.
      </SectionHeading>
      <a href={phoneHref} class="btn btn--outline"><Icon name="phone" /> {hotel.phone.display}</a>
    </div>

    <div class="faq__list">
      {
        faq.map((item) => (
          <details class="faq__item">
            <summary>
              <span>{item.question}</span>
              <Icon name="chevronDown" size={22} class="faq__chevron" />
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: 2rem;
  }

  .faq__list {
    display: grid;
    gap: 0.6rem;
  }

  .faq__item {
    border: 1px solid var(--sand-300);
    border-radius: var(--radius);
    background: var(--white);
  }

  .faq__item[open] {
    box-shadow: var(--shadow-sm);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 56px;
    padding: 1rem 1.3rem;
    border-radius: var(--radius);
    color: var(--navy-900);
    font-size: 1.0625rem;
    font-weight: 650;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary :global(.faq__chevron) {
    flex: none;
    color: var(--gold-700);
    transition: transform 0.25s var(--ease);
  }

  .faq__item[open] summary :global(.faq__chevron) {
    transform: rotate(180deg);
  }

  .faq__item p {
    padding: 0 1.3rem 1.2rem;
    color: var(--gray-600);
  }

  @media (min-width: 960px) {
    .faq {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 4rem;
      align-items: start;
    }
  }
</style>
