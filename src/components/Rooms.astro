---
import { rooms, roomBaseAmenities } from '../content/rooms';
import { hotel, formatBRL } from '../config/hotel';
import { showProvisional } from '../config/flags';
import SectionHeading from './SectionHeading.astro';
import RoomCard from './RoomCard.astro';
import Icon from './Icon.astro';

const visible = rooms.filter((room) => room.status === 'confirmado' || showProvisional);
const hasProvisional = visible.some((room) => room.status === 'provisorio');
---

<section id="acomodacoes" class="section section--white" aria-labelledby="acomodacoes-title">
  <div class="container">
    <SectionHeading eyebrow="Acomodações" title="Quartos simples, confortáveis e bem equipados." id="acomodacoes-title">
      Todos os quartos contam com TV, escrivaninha, roupa de cama, toalhas e Wi-Fi gratuito. Consulte as opções
      disponíveis para as suas datas.
    </SectionHeading>

    {
      hasProvisional && (
        <p class="alert alert--info rooms__dev" role="note">
          <Icon name="info" size={18} />
          <span>
            <strong>Ambiente de desenvolvimento:</strong> as categorias abaixo são provisórias e não aparecem no site
            publicado. Confirme os dados com o hotel em <code>src/content/rooms.ts</code>.
          </span>
        </p>
      )
    }

    {
      visible.length > 0 ? (
        <div class="rooms">
          {visible.map((room) => (
            <RoomCard room={room} />
          ))}
        </div>
      ) : (
        <div class="rooms-general" data-reveal>
          <div>
            <h3>Hospedagem prática para o seu dia a dia em Londrina</h3>
            <p>
              As categorias de quarto, capacidades e tarifas variam conforme a data. Envie sua solicitação e a recepção
              informa as opções disponíveis.
            </p>
            <ul role="list">
              {roomBaseAmenities.map((item) => (
                <li>
                  <Icon name="check" size={16} /> {item}
                </li>
              ))}
            </ul>
          </div>
          <div class="rooms-general__cta">
            <p class="rooms-general__rate">
              <small>Diária de referência</small>
              {formatBRL(hotel.referenceRate.amount)}
            </p>
            <p class="rooms-general__note">{hotel.referenceRate.note}</p>
            <a href="#solicitacao" class="btn btn--gold btn--block" data-room="">
              Consultar disponibilidade
            </a>
          </div>
        </div>
      )
    }
    {visible.some((r) => r.priceFrom) && <p class="rooms__note">* {hotel.referenceRate.note}</p>}
  </div>
</section>

<script>
  import { sendPrefill, goToRequestForm } from '../lib/prefill';

  document.querySelectorAll<HTMLAnchorElement>('[data-room]').forEach((link) =>
    link.addEventListener('click', (event) => {
      event.preventDefault();
      sendPrefill({ subject: 'reserva', roomId: link.dataset.room || undefined });
      goToRequestForm();
    }),
  );
</script>

<style>
  .rooms__dev {
    margin-bottom: 1.5rem;
  }

  .rooms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }

  .rooms__note {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--gray-600);
  }

  .rooms-general {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--offwhite);
  }

  .rooms-general h3 {
    margin-bottom: 0.75rem;
    font-size: 1.6rem;
  }

  .rooms-general p {
    color: var(--gray-600);
  }

  .rooms-general ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .rooms-general li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--line);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--navy-900);
  }

  .rooms-general li :global(svg) {
    color: var(--success);
  }

  .rooms-general__cta {
    display: grid;
    gap: 0.75rem;
    align-content: center;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--navy-900);
    color: var(--white);
  }

  .rooms-general__rate {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--white) !important;
  }

  .rooms-general__rate small {
    display: block;
    margin-bottom: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-300);
  }

  .rooms-general__note {
    font-size: 0.875rem;
    color: rgb(244 238 228 / 0.78) !important;
  }

  @media (min-width: 900px) {
    .rooms-general {
      grid-template-columns: 1.5fr 1fr;
      align-items: center;
    }
  }
</style>
