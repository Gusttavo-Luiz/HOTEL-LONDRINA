---
import { hotel, phoneHref } from '../config/hotel';
import Icon from './Icon.astro';
---

<!-- Celular: barra inferior fixa. Desktop: botão flutuante que some sobre o formulário e o rodapé. -->
<div class="floating" data-floating>
  <a href={phoneHref} class="floating__call">
    <Icon name="phone" size={20} />
    <span>Ligar</span><span class="visually-hidden"> para a recepção {hotel.phone.display}</span>
  </a>
  <a href="/#reservar" class="floating__book">
    <Icon name="calendar" size={20} />
    <span>Consultar disponibilidade</span>
  </a>
</div>

<script>
  const floating = document.querySelector<HTMLElement>('[data-floating]');
  const targets = ['inicio', 'solicitacao', 'contato'].map((id) => document.getElementById(id));
  const footer = document.querySelector('footer');
  if (floating && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
        floating.classList.toggle('is-hidden', visible.size > 0);
      },
      { threshold: 0.05 },
    );
    [...targets, footer].forEach((el) => el && observer.observe(el));
  }
</script>

<style>
  .floating {
    position: fixed;
    z-index: 90;
    display: flex;
    gap: 0.5rem;
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease);
  }

  .floating.is-hidden {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }

  .floating a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 48px;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: var(--shadow);
  }

  .floating__call {
    background: var(--white);
    color: var(--navy-900);
    border: 1.5px solid var(--line);
  }

  .floating__book {
    background: var(--gold-400);
    color: var(--navy-950);
  }

  @media (max-width: 767px) {
    .floating {
      inset: auto 0 0;
      padding: 0.55rem 0.75rem max(0.55rem, env(safe-area-inset-bottom));
      background: rgb(250 248 244 / 0.97);
      border-top: 1px solid var(--line);
      box-shadow: 0 -8px 20px -12px rgb(17 38 74 / 0.3);
    }

    .floating a {
      box-shadow: none;
    }

    .floating__book {
      flex: 1;
    }
  }

  @media (min-width: 768px) {
    .floating {
      right: 1.5rem;
      bottom: 1.5rem;
    }
  }
</style>
