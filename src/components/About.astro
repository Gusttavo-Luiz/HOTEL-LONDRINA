---
import { site } from '../config/site';
import { featuredPhotos } from '../data/photos';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
---

<section id="sobre" class="section about" aria-labelledby="sobre-title">
  <div class="container about__grid">
    <div class="about__media" data-reveal>
      <div class="about__photo">
        <Photo
          file={featuredPhotos.about.file}
          alt={featuredPhotos.about.alt}
          placeholderLabel="Recepção ou ambiente interno"
          widths={[480, 720, 960]}
          sizes="(min-width: 960px) 45vw, 100vw"
        />
      </div>
      <div class="about__years" aria-hidden="true">
        <span class="about__years-number">+{site.yearsOfHistory}</span>
        <span class="about__years-label">anos de<br />história</span>
      </div>
    </div>

    <div class="about__content" data-reveal>
      <p class="eyebrow">Nossa história</p>
      <h2 id="sobre-title">Uma tradição de hospitalidade há mais de 60 anos.</h2>
      <p class="about__intro">Viajar é ótimo, mas nada como se sentir em casa.</p>
      <p>
        Há mais de seis décadas, o Hotel Triunfo recebe turistas, profissionais, estudantes, famílias e viajantes de
        diversas regiões do Brasil.
      </p>
      <p>
        Nosso compromisso é proporcionar uma hospedagem agradável, acessível e bem localizada em Londrina, com
        acomodações simples e aconchegantes, equipe atenciosa e serviços que tornam a estadia mais prática.
      </p>
      <p>
        Estamos no coração da cidade, próximos a restaurantes, bancos, farmácias, museus, comércio e ao terminal de
        ônibus, facilitando a rotina de quem vem a Londrina a trabalho, estudo ou lazer.
      </p>

      <blockquote class="about__values">
        <Icon name="shield" size={22} />
        <p>
          No Hotel Triunfo, valorizamos o respeito aos nossos hóspedes, a higiene, o bom atendimento e a economia.
        </p>
      </blockquote>

      <ul class="about__audience" role="list" aria-label="Quem se hospeda conosco">
        <li>Viagens a trabalho</li>
        <li>Empresas</li>
        <li>Estudantes</li>
        <li>Famílias e turistas</li>
        <li>Estadias longas</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }

  .about__media {
    position: relative;
    padding: 0 1.5rem 1.5rem 0;
  }

  .about__media::before {
    content: '';
    position: absolute;
    inset: 1.5rem 0 0 1.5rem;
    border: 1.5px solid var(--gold-400);
    border-radius: var(--radius-lg);
  }

  .about__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .about__photo :global(img),
  .about__photo :global(picture),
  .about__photo :global(.photo-placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__years {
    position: absolute;
    left: -0.5rem;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 1.4rem;
    border-radius: var(--radius);
    background: var(--navy-900);
    color: var(--white);
    box-shadow: var(--shadow-lg);
  }

  .about__years-number {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 3.25rem);
    font-weight: 600;
    line-height: 1;
    color: var(--gold-300);
  }

  .about__years-label {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .about__content {
    display: grid;
    gap: 1.1rem;
    color: var(--ink-soft);
  }

  .about__content h2 {
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    margin-bottom: 0.25rem;
  }

  .about__intro {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--navy-800);
  }

  .about__values {
    display: flex;
    gap: 0.9rem;
    margin: 0.5rem 0 0;
    padding: 1.1rem 1.25rem;
    border-left: 3px solid var(--gold-500);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--sand-100);
    color: var(--navy-900);
    font-weight: 600;
  }

  .about__values svg {
    flex: none;
    color: var(--gold-700);
  }

  .about__audience {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about__audience li {
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--navy-800);
  }

  @media (min-width: 960px) {
    .about__grid {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
</style>
