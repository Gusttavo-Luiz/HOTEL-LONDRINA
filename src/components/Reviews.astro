---
import { hotel } from '../config/hotel';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const { value, count, updatedAt } = hotel.googleRating;
const pct = (value / 5) * 100;
const starPath =
  'M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95z';
const [year, month] = updatedAt.split('-');
const monthName = new Date(Number(year), Number(month) - 1, 1).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
---

<section id="avaliacoes" class="section section--navy" aria-labelledby="avaliacoes-title">
  <div class="container reviews">
    <SectionHeading eyebrow="Avaliações" title="A experiência de quem já se hospedou conosco." id="avaliacoes-title">
      Nossa reputação é construída por hóspedes reais. Veja todas as opiniões, positivas e críticas, diretamente no
      Google.
    </SectionHeading>

    <div class="reviews__card" data-reveal>
      <p class="reviews__score">
        <span class="reviews__value">{value.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}</span>
        <span class="reviews__of">de 5</span>
      </p>
      <svg class="reviews__stars" viewBox="0 0 130 24" width="150" height="28" role="img" aria-label={`Nota ${value.toLocaleString('pt-BR')} de 5 no Google`}>
        <defs>
          <clipPath id="estrelas-nota"><rect x="0" y="0" width={(130 * pct) / 100} height="24" /></clipPath>
          <g id="estrelas">
            {Array.from({ length: 5 }, (_, i) => (
              <path transform={`translate(${i * 26} 0)`} d={starPath} />
            ))}
          </g>
        </defs>
        <use href="#estrelas" class="reviews__stars-bg" />
        <use href="#estrelas" class="reviews__stars-fg" clip-path="url(#estrelas-nota)" />
      </svg>
      <p class="reviews__count">
        <strong>{count.toLocaleString('pt-BR')} avaliações</strong> no Google
      </p>
      <p class="reviews__updated">Dados de referência de {monthName}.</p>
      <a href={hotel.links.googleReviews} class="btn btn--gold" target="_blank" rel="noopener">
        Ver avaliações no Google <Icon name="external" size={18} />
        <span class="visually-hidden">(abre em nova aba)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .reviews {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .reviews :global(.heading) {
    margin-bottom: 0;
  }

  .reviews__card {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.04);
    text-align: center;
  }

  .reviews__score {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--white);
  }

  .reviews__value {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 4.5rem);
    font-weight: 500;
    line-height: 1;
  }

  .reviews__of {
    font-size: 1.125rem;
    color: rgb(244 238 228 / 0.7);
  }

  .reviews__stars-bg {
    fill: rgb(255 255 255 / 0.22);
  }

  .reviews__stars-fg {
    fill: var(--gold-400);
  }

  .reviews__count {
    color: var(--white);
  }

  .reviews__updated {
    margin-bottom: 0.75rem;
    font-size: 0.8125rem;
    color: rgb(244 238 228 / 0.65);
  }

  @media (min-width: 900px) {
    .reviews {
      grid-template-columns: 1.2fr 1fr;
    }
  }
</style>
