---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, id, align = 'left' } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {Astro.slots.has('default') && <div class="lead"><slot /></div>}
</header>

<style>
  .section-heading {
    display: grid;
    gap: 0.9rem;
    max-width: 44rem;
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }

  .section-heading--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  h2 {
    font-size: clamp(1.85rem, 4vw, 2.75rem);
  }
</style>
