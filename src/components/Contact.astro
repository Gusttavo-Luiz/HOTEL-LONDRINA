---
import { hotel, phoneHref, whatsappUrl, fullAddress } from '../config/hotel';
import { rooms } from '../content/rooms';
import { showProvisional } from '../config/flags';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import RequestForm from './react/RequestForm';

const wa = whatsappUrl('Olá! Gostaria de informações sobre hospedagem no Hotel Triunfo.');
const roomOptions = rooms
  .filter((r) => r.status === 'confirmado' || showProvisional)
  .map((r) => ({ id: r.id, name: r.name }));
---

<section id="contato" class="section section--plain" aria-labelledby="contato-title">
  <div class="container contact">
    <div class="contact__info">
      <SectionHeading eyebrow="Contato e reservas" title="Fale com a recepção do Hotel Triunfo." id="contato-title">
        Envie sua solicitação com as datas da estadia e retornaremos com a disponibilidade e os valores. Para atendimento
        imediato, ligue — a recepção funciona 24 horas.
      </SectionHeading>

      <ul class="contact__list" role="list">
        <li>
          <a href={phoneHref} class="contact-item">
            <span class="contact-item__icon"><Icon name="phone" /></span>
            <span><small>Telefone e reservas</small><strong>{hotel.phone.display}</strong></span>
            <span class="contact-item__action">Ligar</span>
          </a>
        </li>
        {
          wa && (
            <li>
              <a href={wa} class="contact-item" target="_blank" rel="noopener">
                <span class="contact-item__icon contact-item__icon--wa"><Icon name="whatsapp" /></span>
                <span><small>WhatsApp</small><strong>Conversar agora</strong></span>
                <span class="contact-item__action">Abrir</span>
              </a>
            </li>
          )
        }
        <li>
          <a href={hotel.links.directions} class="contact-item" target="_blank" rel="noopener">
            <span class="contact-item__icon"><Icon name="mapPin" /></span>
            <span><small>Endereço</small><strong class="contact-item__address">{fullAddress}</strong></span>
            <span class="contact-item__action">Mapa</span>
          </a>
        </li>
        <li>
          <div class="contact-item">
            <span class="contact-item__icon"><Icon name="clock" /></span>
            <span><small>Atendimento</small><strong>Recepção 24 horas</strong></span>
          </div>
        </li>
      </ul>
      <p class="contact__map-link"><a href="#localizacao">Ver o mapa da localização <Icon name="arrowRight" size={16} /></a></p>
    </div>

    <div id="solicitacao" class="contact__form">
      <RequestForm client:idle phoneDisplay={hotel.phone.display} phoneHref={phoneHref} whatsappHref={wa} rooms={roomOptions} />
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .contact__info :global(.heading) {
    margin-bottom: 1.75rem;
  }

  .contact__list {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 72px;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }

  a.contact-item:hover {
    border-color: var(--sand-300);
    box-shadow: var(--shadow);
  }

  .contact-item small {
    display: block;
    font-size: 0.8125rem;
    color: var(--gray-600);
  }

  .contact-item strong {
    font-size: 1.0625rem;
    color: var(--navy-900);
  }

  .contact-item__address {
    font-size: 0.95rem !important;
    line-height: 1.4;
  }

  .contact-item__icon {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--navy-900);
    color: var(--gold-300);
  }

  .contact-item__icon--wa {
    background: var(--success-500);
    color: var(--white);
  }

  .contact-item__action {
    margin-left: auto;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--gold-700);
  }

  .contact__map-link {
    margin-top: 1rem;
  }

  .contact__map-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
  }

  .contact__form {
    scroll-margin-top: calc(var(--header-h) + 16px);
  }

  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
</style>
