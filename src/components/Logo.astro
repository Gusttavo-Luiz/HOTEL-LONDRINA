---
/**
 * Marca provisória em texto. Ao receber o logotipo oficial, salve-o em
 * public/logo.svg e troque o conteúdo por:
 *   <img src="/logo.svg" alt="Hotel Triunfo" width="…" height="…" />
 */
interface Props {
  tone?: 'dark' | 'light';
}

const { tone = 'dark' } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`]}>
  <svg class="logo__mark" viewBox="0 0 44 44" width="42" height="42" aria-hidden="true">
    <circle cx="22" cy="22" r="20.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M13 15.5h18M22 15.5V31" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
    <path d="M17 31h10" class="logo__accent" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Hotel Triunfo</span>
    <span class="logo__city">Londrina · PR</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 1;
    color: var(--navy-900);
  }

  .logo__mark {
    flex: none;
  }

  .logo__accent {
    stroke: var(--gold-400);
  }

  .logo__text {
    display: grid;
    gap: 0.28rem;
  }

  .logo__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .logo__city {
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold-700);
  }

  .logo--light {
    color: var(--white);
  }

  .logo--light .logo__city {
    color: var(--gold-300);
  }
</style>
