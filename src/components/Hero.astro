---
import { hotel, formatBRL } from '../config/hotel';
import { heroHighlights } from '../content/amenities';
import { featuredPhotos } from '../content/gallery';
import { getPhoto } from '../lib/photos';
import { showProvisional } from '../config/flags';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import BookingWidget from './react/BookingWidget';

const hasPhoto = Boolean(getPhoto(featuredPhotos.hero.file));
---

<section id="inicio" class:list={['hero', { 'hero--photo': hasPhoto }]} aria-labelledby="hero-title">
  <div class="hero__media">
    {
      hasPhoto ? (
        <Photo
          file={featuredPhotos.hero.file}
          alt={featuredPhotos.hero.alt}
          widths={[640, 1024, 1600, 2200]}
          sizes="100vw"
          priority
        />
      ) : (
        <div class="hero__brand-bg" aria-hidden="true" />
      )
    }
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__kicker">
        <Icon name="mapPin" size={16} /> Centro de {hotel.address.city} · {hotel.address.state}
      </p>
      <h1 id="hero-title">Sua estadia em Londrina com conforto, praticidade e economia.</h1>
      <p class="hero__text">
        Bem-vindo ao Hotel Triunfo. Uma opção tradicional no centro de Londrina, com localização estratégica para
        facilitar sua viagem a trabalho, seus compromissos e seus passeios pela cidade.
      </p>
      <div class="hero__actions">
        <a href="#reservar" class="btn btn--gold"><Icon name="calendar" /> Consultar disponibilidade</a>
        <a href="#sobre" class="btn btn--light">Conhecer o hotel <Icon name="arrowRight" /></a>
      </div>
      <ul class="hero__highlights" role="list" aria-label="Destaques">
        {heroHighlights.map((item) => <li><Icon name={item.icon} size={18} /> {item.label}</li>)}
      </ul>
      <p class="hero__note">* Conforme as condições da hospedagem.</p>
    </div>

    {
      !hasPhoto && showProvisional && (
        <div class="hero__dev-slot">
          <Photo file={featuredPhotos.hero.file} alt={featuredPhotos.hero.alt} label="Foto principal (fachada ou acomodação)" />
        </div>
      )
    }
  </div>

  <div class="container hero__booking" id="reservar">
    <div class="hero__booking-head">
      <h2 class="hero__booking-title">Consulte sua hospedagem</h2>
      <p>
        Diária de referência <strong>{formatBRL(hotel.referenceRate.amount)}</strong><span aria-hidden="true">*</span>
        <span class="visually-hidden">({hotel.referenceRate.note})</span>
      </p>
    </div>
    <BookingWidget client:load />
    <p class="hero__rate-note" aria-hidden="true">* {hotel.referenceRate.note}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    color: var(--white);
    background: var(--navy-900);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  .hero__media {
    position: absolute;
    inset: 0 0 clamp(6rem, 14vw, 9rem);
    z-index: -1;
    overflow: hidden;
  }

  .hero__media :global(picture),
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero:not(.hero--photo) .hero__media {
    inset: 0;
  }

  .hero--photo .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(11 26 48 / 0.86) 0%, rgb(11 26 48 / 0.55) 50%, rgb(11 26 48 / 0.2) 100%),
      linear-gradient(0deg, rgb(11 26 48 / 0.6), transparent 40%);
  }

  .hero__brand-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 80% 10%, rgb(207 169 95 / 0.14), transparent 55%),
      linear-gradient(160deg, var(--navy-800), var(--navy-950));
  }

  .hero__brand-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(110deg, transparent 30%, #000 85%);
  }

  .hero__inner {
    display: grid;
    gap: 2rem;
    align-items: center;
    min-height: min(68svh, 640px);
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(2rem, 5vw, 3.5rem);
  }

  .hero__content {
    display: grid;
    gap: 1.25rem;
    max-width: 41rem;
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-300);
  }

  h1 {
    font-size: clamp(2.2rem, 5.4vw, 3.9rem);
    font-weight: 500;
    line-height: 1.06;
    color: var(--white);
  }

  .hero__text {
    max-width: 36rem;
    font-size: clamp(1.0625rem, 1.8vw, 1.2rem);
    color: rgb(244 238 228 / 0.88);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0.5rem 0 0;
    padding: 1.1rem 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.16);
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .hero__highlights li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero__highlights :global(svg) {
    color: var(--gold-300);
  }

  .hero__note {
    margin-top: -0.6rem;
    font-size: 0.8125rem;
    color: rgb(244 238 228 / 0.7);
  }

  .hero__dev-slot {
    display: none;
  }

  .hero__dev-slot :global(.photo-pending) {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
  }

  .hero__booking {
    position: relative;
    display: grid;
    gap: 0.75rem;
  }

  .hero__booking-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .hero__booking-title {
    font-size: 1.35rem;
    color: var(--white);
  }

  .hero__booking-head p {
    font-size: 0.9375rem;
    color: rgb(244 238 228 / 0.85);
  }

  .hero__booking-head strong {
    font-size: 1.125rem;
    color: var(--gold-300);
  }

  .hero__rate-note {
    font-size: 0.8125rem;
    color: rgb(244 238 228 / 0.7);
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: 1.4fr 1fr;
    }

    .hero__dev-slot {
      display: block;
    }
  }
</style>
