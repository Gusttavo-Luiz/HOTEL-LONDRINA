---
import { hotel, formatBRL } from '../config/hotel';
import { heroHighlights } from '../content/amenities';
import { featuredPhotos } from '../content/gallery';
import { getPhoto } from '../lib/photos';
import { showProvisional } from '../config/flags';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import BookingWidget from './react/BookingWidget';

const hasPhoto = Boolean(getPhoto(featuredPhotos.hero.file));
const rating = hotel.googleRating.value.toLocaleString('pt-BR', { minimumFractionDigits: 1 });
---

<section id="inicio" class:list={['hero', { 'hero--photo': hasPhoto }]} aria-labelledby="hero-title">
  <div class="hero__media">
    {
      hasPhoto ? (
        <Photo file={featuredPhotos.hero.file} alt={featuredPhotos.hero.alt} widths={[640, 1024, 1600, 2200]} sizes="100vw" priority />
      ) : (
        <div class="hero__brand-bg" aria-hidden="true">
          <svg class="hero__arcs" viewBox="0 0 800 800" preserveAspectRatio="xMidYMid slice">
            {[120, 200, 280, 360, 440].map((r) => <circle cx="640" cy="160" r={r} />)}
          </svg>
        </div>
      )
    }
  </div>

  {
    !hasPhoto && showProvisional && (
      <p class="hero__dev dev-badge">
        Foto pendente: <code>{featuredPhotos.hero.file}</code>
      </p>
    )
  }

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__kicker">
        <Icon name="mapPin" size={16} /> Centro de {hotel.address.city} · {hotel.address.state}
      </p>
      <h1 id="hero-title">Sua hospedagem em Londrina com conforto e praticidade.</h1>
      <p class="hero__text">
        Hospedagem acessível e tradicional no centro da cidade, com café da manhã incluso, Wi-Fi e estacionamento
        gratuitos e recepção 24 horas — ideal para viagens a trabalho, compromissos e passeios.
      </p>
      <div class="hero__actions">
        <a href="#reservar" class="btn btn--gold"><Icon name="calendar" /> Faça sua reserva</a>
        <a href="#sobre" class="btn btn--light">Conheça o hotel <Icon name="arrowRight" /></a>
      </div>
      <ul class="hero__highlights" role="list" aria-label="Destaques">
        {heroHighlights.map((item) => <li><Icon name={item.icon} size={17} /> {item.label}</li>)}
      </ul>
    </div>

    <aside class="hero__facts" aria-label="Informações rápidas">
      <a class="hero__fact hero__fact--rating" href={hotel.links.googleReviews} target="_blank" rel="noopener">
        <span class="hero__fact-value">{rating}<small>/5</small></span>
        <span class="hero__fact-label">
          Nota no Google<br />{hotel.googleRating.count.toLocaleString('pt-BR')} avaliações
          <span class="visually-hidden">(abre em nova aba)</span>
        </span>
      </a>
      <div class="hero__fact">
        <span class="hero__fact-value">{formatBRL(hotel.referenceRate.amount)}<small>*</small></span>
        <span class="hero__fact-label">Diária de referência</span>
      </div>
      <div class="hero__fact">
        <span class="hero__fact-value">24h</span>
        <span class="hero__fact-label">Recepção todos os dias</span>
      </div>
    </aside>
  </div>

  <div class="container hero__booking" id="reservar">
    <h2 class="hero__booking-title">Faça sua reserva</h2>
    <BookingWidget client:load />
    <p class="hero__notes">
      * {hotel.referenceRate.note} Café da manhã incluso conforme as condições da hospedagem.
    </p>
  </div>
</section>

<style>
  .hero {
    --band: clamp(5.5rem, 12vw, 7rem); /* faixa clara sob o cartão de reserva */
    position: relative;
    isolation: isolate;
    color: var(--white);
    background: var(--offwhite);
  }

  .hero__media {
    position: absolute;
    inset: 0 0 var(--band);
    z-index: -1;
    overflow: hidden;
    background: var(--grad-navy);
  }

  .hero__media :global(picture),
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Sobreposição escura para leitura sobre a foto real */
  .hero--photo .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(95deg, rgb(15 29 40 / 0.9) 0%, rgb(15 29 40 / 0.62) 50%, rgb(15 29 40 / 0.35) 100%),
      linear-gradient(0deg, rgb(15 29 40 / 0.55), transparent 45%);
  }

  .hero__brand-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 60% at 82% 18%, rgb(198 165 107 / 0.16), transparent 70%),
      radial-gradient(ellipse 60% 70% at 0% 100%, rgb(42 74 96 / 0.6), transparent 70%);
  }

  .hero__arcs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgb(198 165 107 / 0.13);
    stroke-width: 1;
  }

  .hero__dev {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
  }

  .hero__inner {
    display: grid;
    gap: 2.25rem;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2.25rem, 5vw, 3.5rem);
  }

  .hero__content {
    display: grid;
    gap: 1.35rem;
    max-width: 40rem;
  }

  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-300);
  }

  h1 {
    font-size: clamp(2.15rem, 5.2vw, 3.75rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--white);
  }

  .hero__text {
    max-width: 35rem;
    font-size: clamp(1.0625rem, 1.7vw, 1.175rem);
    color: rgb(255 255 255 / 0.8);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .hero__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__highlights li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.05);
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(255 255 255 / 0.9);
  }

  .hero__highlights :global(svg) {
    color: var(--gold-400);
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.05);
    backdrop-filter: blur(10px);
    overflow: hidden;
  }

  /* Sobre foto real, o cartão fica mais escuro para manter o contraste. */
  .hero--photo .hero__facts,
  .hero--photo .hero__highlights li {
    background: rgb(15 29 40 / 0.55);
  }

  .hero__fact {
    display: grid;
    align-content: center;
    gap: 0.35rem;
    padding: 1.1rem 1rem;
    color: inherit;
    text-decoration: none;
  }

  .hero__fact + .hero__fact {
    border-left: 1px solid rgb(255 255 255 / 0.12);
  }

  a.hero__fact {
    transition: background-color 0.2s var(--ease);
  }

  a.hero__fact:hover {
    background: rgb(255 255 255 / 0.06);
  }

  .hero__fact-value {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3.2vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--white);
  }

  .hero__fact-value small {
    margin-left: 0.1rem;
    font-size: 0.55em;
    font-weight: 600;
    color: var(--gold-300);
  }

  .hero__fact-label {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: rgb(255 255 255 / 0.72);
  }

  .hero__booking {
    position: relative;
    display: grid;
    gap: 0.75rem;
  }

  .hero__booking-title {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--white);
  }

  .hero__notes {
    font-size: 0.8125rem;
    color: var(--gray-600);
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1.45fr 1fr;
      min-height: min(62svh, 600px);
    }

    .hero__facts {
      grid-template-columns: 1fr;
      max-width: 340px;
      justify-self: end;
    }

    .hero__fact {
      padding: 1.35rem 1.5rem;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 1rem;
    }

    .hero__fact-value {
      min-width: 5.5rem;
    }

    .hero__fact + .hero__fact {
      border-left: 0;
      border-top: 1px solid rgb(255 255 255 / 0.12);
    }
  }

  @media (max-width: 479px) {
    .hero__fact {
      padding: 0.95rem 0.7rem;
    }

    .hero__fact-label {
      font-size: 0.75rem;
    }
  }
</style>
