---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/figtree/wght.css';
import '../styles/global.css';
import { hotel } from '../config/hotel';
import { withBase } from '../lib/url';
import { demoMode } from '../config/flags';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, jsonLd = [], noindex = false } = Astro.props;
const base = Astro.site ?? hotel.url;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(withBase('/og-image.jpg'), base).href;

/** Somente dados verificados — sem avaliações estruturadas autodeclaradas. */
const lodging = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  '@id': `${hotel.url}/#hotel`,
  name: hotel.name,
  alternateName: hotel.tradeName,
  description:
    'Hotel econômico tradicional no centro de Londrina, com café da manhã incluso, Wi-Fi gratuito, estacionamento gratuito e recepção 24 horas.',
  url: `${hotel.url}/`,
  image: ogImage,
  telephone: hotel.phone.e164,
  starRating: { '@type': 'Rating', ratingValue: hotel.stars },
  priceRange: `Diária de referência R$ ${hotel.referenceRate.amount}`,
  currenciesAccepted: 'BRL',
  petsAllowed: true,
  address: {
    '@type': 'PostalAddress',
    streetAddress: hotel.address.street,
    addressLocality: hotel.address.city,
    addressRegion: hotel.address.state,
    postalCode: hotel.address.postalCode,
    addressCountry: hotel.address.country,
  },
  hasMap: hotel.links.directions,
  amenityFeature: [
    'Café da manhã incluso',
    'Estacionamento gratuito',
    'Wi-Fi gratuito',
    'Recepção 24 horas',
    'Aceita animais de estimação',
    'TV no quarto',
    'Escrivaninha',
  ].map((name) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex || demoMode ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#11264a" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="geo.region" content="BR-PR" />
    <meta name="geo.placename" content="Londrina" />

    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={hotel.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hotel Triunfo — hotel econômico no centro de Londrina" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>document.documentElement.classList.add('js')</script>
    {[lodging, ...jsonLd].map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    {
      demoMode && (
        <p class="demo-banner" role="note">
          Versão de demonstração — os formulários não enviam dados. Atendimento real: {hotel.phone.display}.
        </p>
      )
    }
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <FloatingContact />

    <script>
      const blocks = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }),
        { rootMargin: '0px 0px -6% 0px' },
      );
      blocks.forEach((block) => io.observe(block));
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }

  .demo-banner {
    padding: 0.45rem var(--gutter);
    background: var(--gold-300);
    color: var(--navy-950);
    font-size: 0.8125rem;
    font-weight: 600;
    text-align: center;
  }
</style>
