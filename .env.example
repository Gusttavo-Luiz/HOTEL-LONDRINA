# ---------------------------------------------------------------
# Hotel Triunfo — variáveis de ambiente (copie para .env)
# Nunca versione o arquivo .env com valores reais.
# ---------------------------------------------------------------

# --- Públicas (embutidas no HTML durante o build) ---------------
# Número de WhatsApp da recepção, somente dígitos com DDI e DDD.
# Deixe vazio enquanto o hotel não confirmar um número habilitado.
PUBLIC_WHATSAPP_NUMBER=
# Motor de reservas oficial (se existir). Use os marcadores
# {checkin} {checkout} {adults} {children} (datas AAAA-MM-DD).
PUBLIC_BOOKING_ENGINE_URL=
# Mostrar molduras "Foto pendente" e acomodações provisórias
# (padrão: somente em `npm run dev`).
PUBLIC_SHOW_PLACEHOLDERS=

# --- Servidor ----------------------------------------------------
# Pasta do banco SQLite com as solicitações (padrão: ./data)
DATA_DIR=./data
# Exclui solicitações mais antigas que N dias (LGPD). Padrão: 180
DATA_RETENTION_DAYS=180
# true quando estiver atrás de proxy reverso (Nginx, Cloudflare…)
TRUST_PROXY=false
# Máximo de envios do formulário por IP a cada 10 minutos (padrão: 5)
RATE_LIMIT_MAX=5

# Painel /admin (desativado se vazio). Use senha forte (12+ caracteres).
ADMIN_USER=
ADMIN_PASSWORD=

# Envio de e-mail a cada nova solicitação (opcional, recomendado)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Site Hotel Triunfo <nao-responda@seudominio.com.br>"
MAIL_TO=
